[TEMPLATE]
# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase -> Project Settings -> API.
#
# NOTE: these are the PUBLIC anon key values (safe for the browser).
# Never put the service_role key in the frontend.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Server-side only (Ask Ventage) ─────────────────────────────
# These are read by the local server (npm run dev:server) and by Render.
# Do NOT prefix them with VITE_ — anything with VITE_ gets bundled into
# the browser and becomes public. OPENAI_API_KEY must stay server-side.
#
# Get a key at https://platform.openai.com/api-keys (costs money per use).
OPENAI_API_KEY=sk-...            # required for Ask Ventage to work
OPENAI_MODEL=gpt-4o-mini         # optional; cheap default
OPENAI_MAX_TOKENS=700            # optional; caps response length
# AI_PROVIDER=openai             # optional; the AI provider plugin slot
#                                 # (see server/ai/index.ts to register more)
AI_RATE_LIMIT_PER_HOUR=30        # optional; requests per user per hour
# AI_SERVER_PORT=8787            # optional; local server port (Vite proxies /api here)
