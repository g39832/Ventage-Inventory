# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase -> Project Settings -> API.
#
# NOTE: these are the PUBLIC anon key values (safe for the browser).
# Never put the service_role key in the frontend.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Server-side only (Ask Threadly) ─────────────────────────────
# These are read by the local server (npm run dev:server) and by Render.
# Do NOT prefix them with VITE_ — anything with VITE_ gets bundled into
# the browser and becomes public. OPENAI_API_KEY must stay server-side.
#
# Get a key at https://platform.openai.com/api-keys (costs money per use).
OPENAI_API_KEY=sk-...            # server-wide fallback key for Ask Threadly
# NOTE: users can also bring their own key (Settings -> Ask Threadly, stored
# per-user in app_settings.ai). The server uses the user's key first, then
# this one. No key at all = Ask Threadly shows a friendly "not set up" message.
OPENAI_MODEL=gpt-4o-mini         # optional; cheap default
OPENAI_MAX_TOKENS=700            # optional; caps response length
# AI_PROVIDER=openai             # optional; the AI provider plugin slot
#                                 # (see server/ai/index.ts to register more)
AI_RATE_LIMIT_PER_HOUR=30        # optional; requests per user per hour
# AI_SERVER_PORT=8787            # optional; local server port (Vite proxies /api here)

# ── eBay marketplace integration (server-side only) ───────────────
# Lets users connect a real eBay account: publish app items as eBay
# listings and pull live status / recent orders. Create the keys at
# developer.ebay.com → Applications → Keys (a free developer account,
# then approve your app for Production access). Full walkthrough:
# supabase/../EBAY_SETUP.md
#
# EBAY_CLIENT_ID / EBAY_CLIENT_SECRET: from your eBay developer app.
# EBAY_REDIRECT_URI: must match the redirect URL registered in the eBay
# app EXACTLY. It's a frontend route that completes the OAuth handshake:
#   https://your-app.com/ebay/callback   (dev: http://localhost:5173/ebay/callback)
# EBAY_SANDBOX=true for testing with sandbox keys; remove/false for live.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://your-app.com/ebay/callback
# EBAY_SANDBOX=true
